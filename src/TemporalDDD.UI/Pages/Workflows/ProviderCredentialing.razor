@page "/workflows/credentialing"
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject PersonaStateService PersonaStateService

<MudGrid Spacing="4">
    <!-- Top Section: Workflow Start Form -->
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Provider Credentialing Workflow</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Provider ID" Variant="Variant.Outlined" @bind-Value="_providerId" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="License Number" Variant="Variant.Outlined" @bind-Value="_licenseNumber" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Medical Board" Variant="Variant.Outlined" @bind-Value="_medicalBoard" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Expiry Date" Variant="Variant.Outlined" @bind-Date="_expiryDate" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="First Name" Variant="Variant.Outlined" @bind-Value="_firstName" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Last Name" Variant="Variant.Outlined" @bind-Value="_lastName" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="_email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Specialty" Variant="Variant.Outlined" @bind-Value="_specialty" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                @if (_isSubmitting)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        Starting Workflow...
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartWorkflow">
                        Start Workflow
                    </MudButton>
                }
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ResetForm" Disabled="@_isSubmitting">
                    Reset
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- Manual Review Section -->
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Manual Review</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField T="string" Label="Workflow ID" Variant="Variant.Outlined" @bind-Value="_reviewWorkflowId" />
                <MudTextField T="string" Label="Review Notes" Variant="Variant.Outlined" @bind-Value="_reviewNotes" multiline="true" Rows="3" Class="mt-4" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ApproveReview" Disabled="@_isSubmittingReview">
                    Approve
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RejectReview" Disabled="@_isSubmittingReview">
                    Reject
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

</MudGrid>

@code {
    private string _providerId = string.Empty;
    private string _licenseNumber = string.Empty;
    private string _medicalBoard = "American Medical Association";
    private DateTime? _expiryDate = DateTime.Now.AddDays(1);
    private string _firstName = "John";
    private string _lastName = "Doe";
    private string _email = "john.doe@example.com";
    private string _specialty = "Cardiology";
    private bool _isSubmitting = false;
    private string _reviewWorkflowId = string.Empty;
    private string _reviewNotes = string.Empty;
    private bool _isSubmittingReview = false;
    private HttpClient _httpClient = default!;

    protected override void OnInitialized()
    {
        _httpClient = HttpClientFactory.CreateClient("TemporalApi");
        PersonaStateService.OnChange += StateHasChanged;

        // Generate a new ProviderId with prefix
        _providerId = $"PRVId{Guid.NewGuid()}";
    }

    private async Task StartWorkflow()
    {
        if (string.IsNullOrWhiteSpace(_providerId) || string.IsNullOrWhiteSpace(_licenseNumber))
        {
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                ProviderId = _providerId,
                LicenseNumber = _licenseNumber,
                MedicalBoard = _medicalBoard,
                ExpiryDate = _expiryDate ?? DateTime.Now.AddYears(1),
                FirstName = _firstName,
                LastName = _lastName,
                Email = _email,
                Specialty = _specialty
            };

            var response = await _httpClient.PostAsJsonAsync("/api/ProviderCredentialing", request);
            response.EnsureSuccessStatusCode();
            
            var result = await response.Content.ReadFromJsonAsync<CredentialingStartResponse>();
            
            // Reset form after successful workflow start
            ResetForm();
            
            // Generate a new ProviderId for the next submission
            _providerId = $"PRVId{Guid.NewGuid()}";
        }
        catch
        {
            // Handle error - form remains populated for retry
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }


    private void ResetForm()
    {
        _licenseNumber = string.Empty;
        _medicalBoard = "American Medical Association";
        _expiryDate = DateTime.Now.AddDays(1);
        _firstName = "John";
        _lastName = "Doe";
        _email = "john.doe@example.com";
        _specialty = "Cardiology";
        
        StateHasChanged();
    }

    private async Task ApproveReview()
    {
        if (string.IsNullOrWhiteSpace(_reviewWorkflowId)) return;

        _isSubmittingReview = true;
        StateHasChanged();

        try
        {
            var request = new { IsApproved = true, Notes = _reviewNotes };
            var response = await _httpClient.PostAsJsonAsync($"/api/ProviderCredentialing/{_reviewWorkflowId}/manual-review", request);
            response.EnsureSuccessStatusCode();
            
            _reviewWorkflowId = string.Empty;
            _reviewNotes = string.Empty;
        }
        catch
        {
            // Handle error
        }
        finally
        {
            _isSubmittingReview = false;
            StateHasChanged();
        }
    }

    private async Task RejectReview()
    {
        if (string.IsNullOrWhiteSpace(_reviewWorkflowId)) return;

        _isSubmittingReview = true;
        StateHasChanged();

        try
        {
            var request = new { IsApproved = false, Notes = _reviewNotes };
            var response = await _httpClient.PostAsJsonAsync($"/api/ProviderCredentialing/{_reviewWorkflowId}/manual-review", request);
            response.EnsureSuccessStatusCode();
            
            _reviewWorkflowId = string.Empty;
            _reviewNotes = string.Empty;
        }
        catch
        {
            // Handle error
        }
        finally
        {
            _isSubmittingReview = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        PersonaStateService.OnChange -= StateHasChanged;
    }

    private record CredentialingStartResponse(string WorkflowId, string ProviderId, string Message);
}
