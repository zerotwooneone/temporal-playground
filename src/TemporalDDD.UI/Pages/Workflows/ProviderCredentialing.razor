@page "/workflows/credentialing"
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject PersonaStateService PersonaStateService

<MudGrid Spacing="4">
    <!-- Top Section: Workflow Start Form -->
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Provider Credentialing Workflow</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Provider ID" Variant="Variant.Outlined" @bind-Value="_providerId" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="License Number" Variant="Variant.Outlined" @bind-Value="_licenseNumber" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Medical Board" Variant="Variant.Outlined" @bind-Value="_medicalBoard" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Expiry Date" Variant="Variant.Outlined" @bind-Date="_expiryDate" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="First Name" Variant="Variant.Outlined" @bind-Value="_firstName" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Last Name" Variant="Variant.Outlined" @bind-Value="_lastName" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="_email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Specialty" Variant="Variant.Outlined" @bind-Value="_specialty" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartWorkflow" Disabled="@_isWorkflowRunning">
                    Start Workflow
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ResetForm" Disabled="@_isWorkflowRunning">
                    Reset
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- Left Section: Activity Timeline -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Activity Timeline</MudText>
            </MudCardHeader>
            <MudCardContent>
                @if (_workflowId != null)
                {
                    <MudTimeline>
                        <MudTimelineItem>
                            <MudTimelineItemDot Color="@GetTimelineItemColor(0)" Icon="@GetTimelineItemIcon(0)" />
                            <MudTimelineItemLabel>
                                <MudText Typo="Typo.subtitle1">Fetch License</MudText>
                                <MudText Typo="Typo.body2">@GetTimelineItemStatus(0)</MudText>
                            </MudTimelineItemLabel>
                        </MudTimelineItem>
                        <MudTimelineItem>
                            <MudTimelineItemDot Color="@GetTimelineItemColor(1)" Icon="@GetTimelineItemIcon(1)" />
                            <MudTimelineItemLabel>
                                <MudText Typo="Typo.subtitle1">Evaluate Compliance</MudText>
                                <MudText Typo="Typo.body2">@GetTimelineItemStatus(1)</MudText>
                            </MudTimelineItemLabel>
                        </MudTimelineItem>
                        <MudTimelineItem>
                            <MudTimelineItemDot Color="@GetTimelineItemColor(2)" Icon="@GetTimelineItemIcon(2)" />
                            <MudTimelineItemLabel>
                                <MudText Typo="Typo.subtitle1">Manual Review</MudText>
                                <MudText Typo="Typo.body2">@GetTimelineItemStatus(2)</MudText>
                            </MudTimelineItemLabel>
                        </MudTimelineItem>
                        <MudTimelineItem>
                            <MudTimelineItemDot Color="@GetTimelineItemColor(3)" Icon="@GetTimelineItemIcon(3)" />
                            <MudTimelineItemLabel>
                                <MudText Typo="Typo.subtitle1">Activate Profile</MudText>
                                <MudText Typo="Typo.body2">@GetTimelineItemStatus(3)</MudText>
                            </MudTimelineItemLabel>
                        </MudTimelineItem>
                    </MudTimeline>
                    <MudText Class="mt-4" Typo="Typo.caption">Workflow ID: @_workflowId</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body1" Class="text-muted">
                        Start a workflow to see activity timeline
                    </MudText>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Right Section: Role-Based Action Controls -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Credentialing Actions</MudText>
            </MudCardHeader>
            <MudCardContent>
                @if (PersonaStateService.CurrentUserRole == UserRole.Credentialing)
                {
                    <MudTextField T="string" Label="Review Notes" Variant="Variant.Outlined" @bind-Value="_reviewNotes" multiline="true" Rows="3" />
                }
                else if (PersonaStateService.CurrentUserRole == UserRole.Provider)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        <MudText Typo="Typo.body2">
                            Awaiting CHG Review. Please check back later for credentialing status.
                        </MudText>
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <MudText Typo="Typo.body2">
                            You must be in the Credentialing role to perform manual reviews.
                        </MudText>
                    </MudAlert>
                }
            </MudCardContent>
            @if (PersonaStateService.CurrentUserRole == UserRole.Credentialing)
            {
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ApproveReview" Disabled="@(!_isWaitingForManualReview)">
                        Approve
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RejectReview" Disabled="@(!_isWaitingForManualReview)">
                        Reject
                    </MudButton>
                </MudCardActions>
            }
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string _providerId = string.Empty;
    private string _licenseNumber = string.Empty;
    private string _medicalBoard = "American Medical Association";
    private DateTime? _expiryDate = DateTime.Now.AddDays(1);
    private string _firstName = "John";
    private string _lastName = "Doe";
    private string _email = "john.doe@example.com";
    private string _specialty = "Cardiology";
    private string _reviewNotes = string.Empty;

    private string? _workflowId;
    private bool _isWorkflowRunning = false;
    private bool _isWaitingForManualReview = false;

    private int _currentStep = 0; // 0=Fetch, 1=Evaluate, 2=Review, 3=Activate
    private bool _workflowCompleted = false;

    private System.Threading.PeriodicTimer? _pollingTimer;
    private CancellationTokenSource? _cancellationTokenSource;
    private HttpClient _httpClient = default!;

    protected override void OnInitialized()
    {
        _httpClient = HttpClientFactory.CreateClient("TemporalApi");
        PersonaStateService.OnChange += StateHasChanged;

        // Generate a new ProviderId with prefix
        _providerId = $"PRVId{Guid.NewGuid()}";
    }

    private async Task StartWorkflow()
    {
        if (string.IsNullOrWhiteSpace(_providerId) || string.IsNullOrWhiteSpace(_licenseNumber))
        {
            return;
        }

        _isWorkflowRunning = true;
        _workflowCompleted = false;
        _currentStep = 0;

        try
        {
            var request = new
            {
                ProviderId = _providerId,
                LicenseNumber = _licenseNumber,
                MedicalBoard = _medicalBoard,
                ExpiryDate = _expiryDate ?? DateTime.Now.AddYears(1),
                FirstName = _firstName,
                LastName = _lastName,
                Email = _email,
                Specialty = _specialty
            };

            var response = await _httpClient.PostAsJsonAsync("/api/ProviderCredentialing", request);
            response.EnsureSuccessStatusCode();
            
            var result = await response.Content.ReadFromJsonAsync<CredentialingStartResponse>();
            _workflowId = result?.WorkflowId;
            
            //create a closure to capture the providerIdForStatus
            var providerIdForStatus = result?.ProviderId;

            // Start polling for workflow status
            _cancellationTokenSource = new CancellationTokenSource();
            _pollingTimer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(1.5));
            
            _ = PollWorkflowStatusAsync(providerIdForStatus, _cancellationTokenSource.Token);
        }
        catch
        {
            _isWorkflowRunning = false;
            _workflowId = null;
        }
        
        StateHasChanged();
    }

    private async Task PollWorkflowStatusAsync(string? providerIdForStatus, CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollingTimer!.WaitForNextTickAsync(cancellationToken))
            {
                if (_workflowId == null || _workflowCompleted)
                    break;

                try
                {
                    var response = await _httpClient.GetAsync($"/api/ProviderCredentialing/providers/{providerIdForStatus}/status");
                    if (response.IsSuccessStatusCode)
                    {
                        var status = await response.Content.ReadFromJsonAsync<CredentialingStatusResponse>();
                        if (status != null)
                        {
                            _currentStep = status.Step;
                            _isWaitingForManualReview = status.IsWaitingForManualReview;
                            
                            if (status.Status == "Approved" || status.Status == "Rejected")
                            {
                                _workflowCompleted = true;
                                _isWorkflowRunning = false;
                                _isWaitingForManualReview = false;
                            }
                        }
                    }
                    
                    await InvokeAsync(StateHasChanged);
                }
                catch
                {
                    // API might not be ready yet
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when component is disposed
        }
    }

    private async Task ApproveReview()
    {
        if (_workflowId == null) return;

        try
        {
            var request = new { IsApproved = true, Notes = _reviewNotes };
            var response = await _httpClient.PostAsJsonAsync($"/api/ProviderCredentialing/{_workflowId}/manual-review", request);
            response.EnsureSuccessStatusCode();
            
            _isWaitingForManualReview = false;
            StateHasChanged();
        }
        catch
        {
            // Handle error
        }
    }

    private async Task RejectReview()
    {
        if (_workflowId == null) return;

        try
        {
            var request = new { IsApproved = false, Notes = _reviewNotes };
            var response = await _httpClient.PostAsJsonAsync($"/api/ProviderCredentialing/{_workflowId}/manual-review", request);
            response.EnsureSuccessStatusCode();
            
            _isWaitingForManualReview = false;
            StateHasChanged();
        }
        catch
        {
            // Handle error
        }
    }

    private void ResetForm()
    {
        _providerId = string.Empty;
        _licenseNumber = string.Empty;
        _medicalBoard = string.Empty;
        _expiryDate = null;
        _reviewNotes = string.Empty;
        _workflowId = null;
        _isWorkflowRunning = false;
        _isWaitingForManualReview = false;
        _currentStep = 0;
        _workflowCompleted = false;
        
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;
        _pollingTimer?.Dispose();
        _pollingTimer = null;
        
        StateHasChanged();
    }

    private Color GetTimelineItemColor(int step)
    {
        if (step < _currentStep)
            return Color.Success;
        if (step == _currentStep && _isWorkflowRunning)
            return Color.Info;
        if (step == _currentStep && _isWaitingForManualReview)
            return Color.Warning;
        return Color.Default;
    }

    private string GetTimelineItemIcon(int step)
    {
        if (step < _currentStep)
            return Icons.Material.Filled.CheckCircle;
        if (step == _currentStep && _isWorkflowRunning)
            return Icons.Material.Filled.HourglassEmpty;
        if (step == _currentStep && _isWaitingForManualReview)
            return Icons.Material.Filled.Pending;
        return Icons.Material.Filled.Circle;
    }

    private string GetTimelineItemStatus(int step)
    {
        if (step < _currentStep)
            return "Completed";
        if (step == _currentStep && _isWorkflowRunning)
            return "In Progress";
        if (step == _currentStep && _isWaitingForManualReview)
            return "Awaiting Review";
        return "Pending";
    }

    public void Dispose()
    {
        PersonaStateService.OnChange -= StateHasChanged;
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _pollingTimer?.Dispose();
    }

    private record CredentialingStartResponse(string WorkflowId, string ProviderId, string Message);
    private record CredentialingStatusResponse(string Status, int Step, bool IsWaitingForManualReview, bool? IsCompliant, string? Notes);
}
