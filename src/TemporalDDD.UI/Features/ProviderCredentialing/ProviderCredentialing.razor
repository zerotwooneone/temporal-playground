@page "/workflows/credentialing"
@using Microsoft.AspNetCore.SignalR.Client
@using TemporalDDD.Contracts.ProviderCredentialing
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject PersonaStateService PersonaStateService
@inject IConfiguration Configuration

<MudGrid Spacing="4">
    <!-- Top Section: Workflow Start Form -->
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Provider Credentialing Workflow</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="License Number" Variant="Variant.Outlined" @bind-Value="_licenseNumber" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Medical Board" Variant="Variant.Outlined" @bind-Value="_medicalBoard" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Expiry Date" Variant="Variant.Outlined" @bind-Date="_expiryDate" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="First Name" Variant="Variant.Outlined" @bind-Value="_firstName" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Last Name" Variant="Variant.Outlined" @bind-Value="_lastName" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="_email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Specialty" Variant="Variant.Outlined" @bind-Value="_specialty" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                @if (_isSubmitting)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        Starting Workflow...
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartWorkflow" Disabled="@(PersonaStateService.CurrentUserRole != UserRole.Credentialing)">
                        Start Workflow
                    </MudButton>
                }
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ResetForm" Disabled="@_isSubmitting">
                    Reset
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- Manual Review Section -->
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Pending Manual Reviews</MudText>
            </MudCardHeader>
            <MudCardContent>
                @if (_pendingReviews == null || _pendingReviews.Count == 0)
                {
                    <MudText Typo="Typo.body1" Class="text-muted">
                        No pending manual reviews
                    </MudText>
                }
                else
                {
                    <MudTable Items="@_pendingReviews" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Watching</MudTh>
                            <MudTh>Provider ID</MudTh>
                            <MudTh>License Number</MudTh>
                            <MudTh>Medical Board</MudTh>
                            <MudTh>Evaluated At</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @if (_trackedEvaluationPublicIds.Contains(context.EvaluationPublicId))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" />
                                }
                            </MudTd>
                            <MudTd>@context.ProviderPublicId</MudTd>
                            <MudTd>@context.LicenseNumber</MudTd>
                            <MudTd>@context.MedicalBoard</MudTd>
                            <MudTd>@context.EvaluatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                            <MudTd>
                                @if (_processingTrackingTokens.Contains(context.EvaluationPublicId))
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" 
                                        OnClick="() => ApproveReview(context.TrackingToken)" Disabled="@(PersonaStateService.CurrentUserRole != UserRole.Credentialing)">
                                        Approve
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" 
                                        OnClick="() => RejectReview(context.TrackingToken)" Disabled="@(PersonaStateService.CurrentUserRole != UserRole.Credentialing)" Class="ml-2">
                                        Reject
                                    </MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" OnClick="LoadPendingReviews">
                    Refresh
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

</MudGrid>

@code {
    private string _licenseNumber = string.Empty;
    private string _medicalBoard = "American Medical Association";
    private DateTime? _expiryDate = DateTime.Now.AddDays(1);
    private string _firstName = "John";
    private string _lastName = "Doe";
    private string _email = "john.doe@example.com";
    private string _specialty = "Cardiology";
    private bool _isSubmitting = false;
    private HashSet<string> _processingTrackingTokens = new();
    private List<PendingManualReviewDto> _pendingReviews = new();
    private HashSet<string> _trackedEvaluationPublicIds = new();
    private HttpClient _httpClient = default!;
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("TemporalApi");
        PersonaStateService.OnChange += StateHasChanged;
        
        // Initialize SignalR connection
        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? throw new InvalidOperationException("ApiBaseUrl not found");
        
        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{apiBaseUrl}/hubs/applicationevents", options =>
            {
                options.HttpMessageHandlerFactory = _ => CreateHttpClientHandler();
                options.SkipNegotiation = false;
            })
            .Build();

        _hubConnection.On<CredentialEvaluationCreatedEvent>("CredentialEvaluationCreated", async (eventData) =>
        {
            Console.WriteLine($"Received CredentialEvaluationCreated event: {eventData.EvaluationPublicId}");
            await InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<CredentialEvaluationApprovedEvent>("CredentialEvaluationApproved", async (eventData) =>
        {
            Console.WriteLine($"Received CredentialEvaluationApproved event: {eventData.EvaluationPublicId}");
            await InvokeAsync(() =>
            {
                _pendingReviews.RemoveAll(r => r.EvaluationPublicId == eventData.EvaluationPublicId);
                _trackedEvaluationPublicIds.Remove(eventData.EvaluationPublicId);
                _processingTrackingTokens.Remove(eventData.EvaluationPublicId);
                StateHasChanged();
            });
            if (_hubConnection != null)
            {
                await _hubConnection.InvokeAsync("LeaveProviderGroup", eventData.EvaluationPublicId);
            }
        });

        _hubConnection.On<CredentialEvaluationRejectedEvent>("CredentialEvaluationRejected", async (eventData) =>
        {
            Console.WriteLine($"Received CredentialEvaluationRejected event: {eventData.EvaluationPublicId}");
            await InvokeAsync(() =>
            {
                _pendingReviews.RemoveAll(r => r.EvaluationPublicId == eventData.EvaluationPublicId);
                _trackedEvaluationPublicIds.Remove(eventData.EvaluationPublicId);
                _processingTrackingTokens.Remove(eventData.EvaluationPublicId);
                StateHasChanged();
            });
            if (_hubConnection != null)
            {
                await _hubConnection.InvokeAsync("LeaveProviderGroup", eventData.EvaluationPublicId);
            }
        });

        _hubConnection.On<CredentialEvaluationRequiresManualReviewEvent>("CredentialEvaluationRequiresManualReview", async (eventData) =>
        {
            Console.WriteLine($"Received CredentialEvaluationRequiresManualReview event: {eventData.EvaluationPublicId}");
            await LoadPendingReviews();
            await InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
        
        // Load pending reviews on initialization
        _ = LoadPendingReviews();
    }

    private async Task StartWorkflow()
    {
        if (string.IsNullOrWhiteSpace(_licenseNumber))
        {
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                LicenseNumber = _licenseNumber,
                MedicalBoard = _medicalBoard,
                ExpiryDate = _expiryDate.HasValue ? DateOnly.FromDateTime(_expiryDate.Value) : throw new InvalidOperationException("Expiry date is required"),
                FirstName = _firstName,
                LastName = _lastName,
                Email = _email,
                Specialty = _specialty
            };

            var response = await _httpClient.PostAsJsonAsync("/api/ProviderCredentialing", request);
            response.EnsureSuccessStatusCode();
            
            var result = await response.Content.ReadFromJsonAsync<CredentialingStartResponse>();
            
            // Track this evaluation and join SignalR group
            if (result != null && !string.IsNullOrWhiteSpace(result.EvaluationPublicId))
            {
                _trackedEvaluationPublicIds.Add(result.EvaluationPublicId);
                await _hubConnection.InvokeAsync("JoinProviderGroup", result.EvaluationPublicId);
            }
            
            // Reset form after successful workflow start
            ResetForm();
        }
        catch
        {
            // Handle error - form remains populated for retry
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }


    private void ResetForm()
    {
        _licenseNumber = string.Empty;
        _medicalBoard = "American Medical Association";
        _expiryDate = DateTime.Now.AddDays(1);
        _firstName = "John";
        _lastName = "Doe";
        _email = "john.doe@example.com";
        _specialty = "Cardiology";
        
        StateHasChanged();
    }

    private async Task LoadPendingReviews()
    {
        try
        {
            var response = await _httpClient.GetAsync("/api/ProviderCredentialing/pending-reviews");
            if (response.IsSuccessStatusCode)
            {
                _pendingReviews = await response.Content.ReadFromJsonAsync<List<PendingManualReviewDto>>() ?? new();
                
                // Cleanup tracking state for reviews that are no longer pending
                var currentEvaluationPublicIds = _pendingReviews.Select(r => r.EvaluationPublicId).ToHashSet();
                _trackedEvaluationPublicIds.RemoveWhere(id => !currentEvaluationPublicIds.Contains(id));
                _processingTrackingTokens.RemoveWhere(id => !currentEvaluationPublicIds.Contains(id));
            }
        }
        catch
        {
            // Handle error
        }
        StateHasChanged();
    }

    private async Task ApproveReview(string trackingToken)
    {
        var review = _pendingReviews.FirstOrDefault(r => r.TrackingToken == trackingToken);
        if (review != null)
        {
            _trackedEvaluationPublicIds.Add(review.EvaluationPublicId);
            _processingTrackingTokens.Add(review.EvaluationPublicId);
            if (_hubConnection != null)
            {
                await _hubConnection.InvokeAsync("JoinProviderGroup", review.EvaluationPublicId);
            }
        }

        StateHasChanged();

        try
        {
            var request = new { IsApproved = true, Notes = (string?)null };
            var response = await _httpClient.PostAsJsonAsync($"/api/ProviderCredentialing/{trackingToken}/manual-review", request);
            response.EnsureSuccessStatusCode();
        }
        catch
        {
            // Handle error - clear spinner on error
            await InvokeAsync(() =>
            {
                if (review != null)
                {
                    _processingTrackingTokens.Remove(review.EvaluationPublicId);
                }
                StateHasChanged();
            });
        }
    }

    private async Task RejectReview(string trackingToken)
    {
        var review = _pendingReviews.FirstOrDefault(r => r.TrackingToken == trackingToken);
        if (review != null)
        {
            _trackedEvaluationPublicIds.Add(review.EvaluationPublicId);
            _processingTrackingTokens.Add(review.EvaluationPublicId);
            if (_hubConnection != null)
            {
                await _hubConnection.InvokeAsync("JoinProviderGroup", review.EvaluationPublicId);
            }
        }

        StateHasChanged();

        try
        {
            var request = new { IsApproved = false, Notes = "Manual review rejected" };
            var response = await _httpClient.PostAsJsonAsync($"/api/ProviderCredentialing/{trackingToken}/manual-review", request);
            response.EnsureSuccessStatusCode();
        }
        catch
        {
            // Handle error - clear spinner on error
            await InvokeAsync(() =>
            {
                if (review != null)
                {
                    _processingTrackingTokens.Remove(review.EvaluationPublicId);
                }
                StateHasChanged();
            });
        }
    }

    public async void Dispose()
    {
        PersonaStateService.OnChange -= StateHasChanged;
        
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private HttpClientHandler CreateHttpClientHandler()
    {
        return new HttpClientHandler
        {
            ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator
        };
    }

}
